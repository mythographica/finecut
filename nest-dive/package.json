{
	"name": "finecut-nestjs",
	"version": "0.1.0",
	"description": "FineCut CMS — NestJS pilot using @mnemonica/nestjs adapter",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"start": "node build/src/main.js",
		"dev": "node --watch build/src/main.js 2>&1 | tee -a server.log",
		"tactica": "npx tactica --esm --verbose",
		"test": "vitest run",
		"test:watch": "vitest",
		"load:proof": "npm run build && node scripts/load-context-proof.mjs",
		"proof:queue": "npm run build && node scripts/queue-attribution-proof.mjs"
	},
	"dependencies": {
		"@fastify/formbody": "^8.0.2",
		"@mnemonica/dive": "^0.10.4",
		"@mnemonica/nestjs": "^0.9.0",
		"@nestjs/common": "^10.4.0",
		"@nestjs/core": "^10.4.0",
		"@nestjs/platform-fastify": "^10.4.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.79.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.10.0",
		"@opentelemetry/sdk-node": "^0.221.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"elfinder-node": "^2.3.6",
		"elfinder-npm": "^2.1.28",
		"fastify": "^4.28.0",
		"mnemonica": "^1.4.2",
		"pino": "^9.0.0",
		"pino-pretty": "^13.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.0",
		"typeomatica": "^0.3.63"
	},
	"devDependencies": {
		"@mnemonica/tactica": "^0.4.8",
		"@nestjs/testing": "^10.4.0",
		"@types/node": "^20.0.0",
		"autocannon": "^8.0.0",
		"typescript": "^5.5.0",
		"vitest": "^2.0.0"
	}
}
