{
	"name": "finecut-express-otel",
	"version": "1.0.0",
	"description": "FineCut CMS Backend — Express 5 + mnemonica page engine + @mnemonica/otel observability",
	"main": "build/src/core/server.js",
	"type": "module",
	"scripts": {
		"start": "node build/src/core/server.js",
		"dev": "node --watch build/src/core/server.js 2>&1 | tee -a server.log",
		"build": "tsc",
		"build:watch": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"cache:clear": "rm -rf data/static/*",
		"tactica": "npx tactica --esm --verbose"
	},
	"dependencies": {
		"@mnemonica/dive": "^0.8.7",
		"@mnemonica/otel": "^0.1.0",
		"@mnemonica/tactica": "0.1.9",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.10.0",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@opentelemetry/sdk-trace-node": "^2.10.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"elfinder-node": "^2.1.1",
		"elfinder-npm": "^2.1.28",
		"express": "^5.0.0",
		"mnemonica": "^1.3.0",
		"pino": "^9.0.0",
		"pino-pretty": "^13.0.0"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^8.59.1",
		"@typescript-eslint/parser": "^8.59.1",
		"eslint": "^10.3.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
